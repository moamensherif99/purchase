<odoo>
    <record id="purchase_order_form_view_inherit" model="ir.ui.view">
        <field name="name">purchase order form view inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="exceed_discount_limit" widget="checkbox"/>
            </xpath>
            <xpath expr="//header/button[@name='button_confirm']" position="attributes">
                <attribute name="invisible">state != 'waiting'</attribute>
                <attribute name="groups">purchase.group_purchase_manager</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'to approve', 'sent', 'waiting','purchase'] or not id </attribute>
            </xpath>
        </field>
    </record>
</odoo>
